PORT=4173
PUBLIC_URL=https://onlead.m360-ural.online
# 32 bytes hex — as in post2post TOKEN_ENCRYPTION_KEY
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_EMAIL=admin@onlead.local
ADMIN_PASSWORD=admin1234
# Classic VK app (dev.vk.com) — user token vk1.a… для wall/groups.
VK_APP_ID=5530956
VK_REDIRECT_URI=https://oauth.vk.com/blank.html
VK_MESSAGES_APP_ID=6463690
# Опционально: bitmask scope. По умолчанию 557058 (friends+wall+groups). Полный: 638982.
# VK_SCOPE=638982
VK_CLIENT_SECRET=
# Тот же магазин ЮKassa, что у post2post. live + ключи — реальная оплата.
PAYMENTS_MODE=stub
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=
# 1 — встроенные сети ЮKassa; 0 — выкл; либо список CIDR через запятую.
YOOKASSA_IP_ALLOWLIST=
# Тот же SMTP, что у post2post (noreply@m360-ural.online).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
# Юридические реквизиты для #/privacy и #/offer (152-ФЗ). Без ИНН страницы-заготовки. Можно задать в админке.
LEGAL_OPERATOR=
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# 1 — принимать оплату тарифов Telegram (воркер отвечает через webhook).
TELEGRAM_LIVE=1
# Выносная копия бэкапов (вне Docker volume). В compose: /opt/onlead/backups
BACKUP_OFFSITE_DIR=
# Внешнее хранилище: S3-совместимый PUT (MinIO post2post / Timeweb / Yandex) или HTTP PUT.
# На общем VPS деплой сам копирует MINIO_* → S3_BACKUP_* (бакет onlead-backups, регион us-east-1).
S3_BACKUP_ENDPOINT=
S3_BACKUP_REGION=us-east-1
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
S3_BACKUP_PREFIX=onlead/
# Второй контур (другой ДЦ). Не копируйте сюда ключи MinIO этого VPS.
S3_GEO_BACKUP_ENDPOINT=
S3_GEO_BACKUP_REGION=ru-1
S3_GEO_BACKUP_BUCKET=
S3_GEO_BACKUP_ACCESS_KEY=
S3_GEO_BACKUP_SECRET_KEY=
S3_GEO_BACKUP_PREFIX=onlead/
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
# 1 — разрешить mock:vk / mock:demo. В Docker NODE_ENV=production по умолчанию выключено.
ALLOW_MOCK_TOKENS=
# Таймаут запроса к ИИ, мс. Бесплатные модели стоят в очереди до минуты. По умолчанию 60000.
AI_TIMEOUT_MS=
# Cloudflare DNS для PRO-лендингов (поддомены m360-ural.online).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=4dd89c2f20fa46d1c4cdbe47eaf7d0a0
LANDING_DNS_ZONES=m360-ural.online
LANDING_DNS_TARGET=66.151.42.48
LANDING_DNS_PROXIED=1
# 0 — не создавать DNS при публикации (локальная разработка).
LANDING_DNS_ENABLED=1
